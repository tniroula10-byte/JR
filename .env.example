# ==============================================================================
# JOHN RAMBO — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit `.env` or `.env.local` to version control.
# NEVER place secret keys in variables prefixed with `NEXT_PUBLIC_`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Application & Supabase Client Configuration (Browser-Safe)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="John Rambo"
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Web Push Public VAPID Key (Phase 10 PWA Push Notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key-here"

# ------------------------------------------------------------------------------
# 2. Server-Only Supabase & Bootstrap Secrets (NEVER EXPOSE TO BROWSER)
# ------------------------------------------------------------------------------
# Used exclusively in `lib/supabase/admin.ts` (enforced via `import 'server-only'`)
# and `scripts/seed-boss.ts`.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# Direct Postgres connection string for migrations, pgTAP tests, and CI RLS checks
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Singleton Boss Bootstrap Configuration (Used by `scripts/seed-boss.ts`)
BOSS_EMAIL="boss@example.com"
BOSS_FULL_NAME="John Rambo Boss"
BOSS_PHONE="+919876543210"

# ------------------------------------------------------------------------------
# 3. Email Delivery (Resend Custom SMTP / Transactional Auth Emails)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM_ADDRESS="John Rambo Support <auth@yourdomain.com>"

# ------------------------------------------------------------------------------
# 4. Web Push Private Configuration (Server-Only, Phase 10)
# ------------------------------------------------------------------------------
VAPID_PRIVATE_KEY="your-vapid-private-key-here"
VAPID_SUBJECT="mailto:support@yourdomain.com"

# ------------------------------------------------------------------------------
# 5. Scheduled Jobs / Cron Security (Server-Only)
# ------------------------------------------------------------------------------
# Verifies requests to `/api/cron/auto-close-tickets` and `/api/cron/expire-stories`
CRON_SECRET="generate-a-64-char-random-hex-secret-here"

# ------------------------------------------------------------------------------
# 6. Local Demo Mode (NEVER set in a real deployment)
# ------------------------------------------------------------------------------
# Without Supabase keys the app runs on in-memory demo data. Demo persona logins
# (`?as=boss-1`) work in `next dev` only. Set to 1 to allow them under
# `next start` for E2E tests. Ignored whenever real Supabase keys are present.
# JR_FORCE_MOCK="1"
# JR_ALLOW_DEMO_AUTH="1"

# ------------------------------------------------------------------------------
# 7. Error Alerts (server errors are emailed here, via the email settings above)
# ------------------------------------------------------------------------------
ALERT_EMAIL="you@yourdomain.com"

# Local development only: send app emails to the Supabase stack's Mailpit inbox
# (http://127.0.0.1:54324) instead of Resend.
# MAILPIT_URL="http://127.0.0.1:54324"
